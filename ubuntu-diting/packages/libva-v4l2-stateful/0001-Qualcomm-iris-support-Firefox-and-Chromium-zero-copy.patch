+/*
+ * Give a surface its own linear NV12 buffer (allocated as R8, 1.5x high).
+ */
+static int surface_alloc_own(V4L2Driver *drv, V4L2Surface *surface)
+{
+    if (drv->gbm == NULL) {
+        if (drv->drm_fd < 0)
+            return -1;
+        drv->gbm = gbm_create_device(drv->drm_fd);
+        if (drv->gbm == NULL) {
+            LOG("gbm_create_device failed");
+            return -1;
+        }
+    }
+
+    /*
+     * Use the layout the decoder writes (Qualcomm iris NV12: 128-byte
+     * stride, rows aligned to 32 (Y) and 16 (UV), 4 KiB total alignment), so
+     * that it can decode straight into this buffer.
