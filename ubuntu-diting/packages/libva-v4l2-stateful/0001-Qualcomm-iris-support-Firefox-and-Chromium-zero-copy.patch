+static int qbuf_dmabuf(V4L2Context *ctx, int idx, V4L2Surface *surface)
+{
+    struct v4l2_buffer buf;
+    struct v4l2_plane planes[1];
+
+    memset(&buf, 0, sizeof(buf));
+    memset(&planes, 0, sizeof(planes));
+    buf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
+    buf.memory = V4L2_MEMORY_DMABUF;
+    buf.index = idx;
+    buf.length = 1;
+    buf.m.planes = planes;
+    planes[0].m.fd = surface->own_fd;
+    planes[0].length = surface->own_size;
+
+    if (ioctl(ctx->v4l2_fd, VIDIOC_QBUF, &buf) < 0) {
+        LOG("Failed to queue DMABUF CAPTURE buffer %d: %s", idx, strerror(errno));
+        return -1;
+    }
+    ctx->cap_slot[idx] = surface;
+    ctx->capture_buffers[idx].queued = true;
+    return 0;
+}
+
+static bool surface_fits(V4L2Context *ctx, V4L2Surface *surface)
+{
+    return surface->own_ptr != NULL && surface->own_size >= ctx->cap_size &&
+           surface->own_stride == ctx->cap_stride[0] &&
+           surface->own_uv_offset == ctx->cap_uv_offset;
+}
+
+/*
+ * DMABUF mode: keep exactly one CAPTURE buffer queued, the own buffer of the
+ * oldest frame still waiting for its picture. The firmware also returns
+ * empty buffers (no timestamp) at unpredictable points; with several queued
+ * those would shift every following picture into the wrong surface, while a
+ * single buffer is simply queued again. Called with ctx->mutex held.
+ */
+void v4l2_feed_capture(V4L2Context *ctx)
+{
+    if (!ctx->cap_dmabuf || !ctx->streaming_output)
+        return;
+
+    for (int i = 0; i < ctx->num_capture_buffers; i++)
+        if (ctx->capture_buffers[i].queued)
+            return;
+
+    V4L2Surface *oldest = NULL;
+    uint64_t oldest_ts = 0;
+    for (int i = 0; i < TS_MAP_SIZE; i++) {
+        if (ctx->ts_map[i].surface &&
+            (oldest == NULL || ctx->ts_map[i].ts < oldest_ts)) {
+            oldest = ctx->ts_map[i].surface;
+            oldest_ts = ctx->ts_map[i].ts;
+        }
+    }
+    if (oldest == NULL)
+        return;
+
+    if (!surface_fits(ctx, oldest)) {
+        LOG("Surface buffer does not fit the CAPTURE layout");
+        return;
+    }
+
+    /* Reuse the surface's slot so its dmabuf stays attached */
+    int idx = -1;
+    for (int i = 0; idx < 0 && i < ctx->num_capture_buffers; i++)
+        if (ctx->cap_slot[i] == oldest)
+            idx = i;
+    for (int i = 0; idx < 0 && i < ctx->num_capture_buffers; i++)
+        if (ctx->cap_slot[i] == NULL)
+            idx = i;
+    if (idx < 0) {
+        /* All slots taken by other surfaces: recycle the first one */
+        idx = 0;
+    }
+
+    qbuf_dmabuf(ctx, idx, oldest);
+}
+
+/*
+ * Drop every reference to a surface that is being destroyed.
+ */
+void v4l2_forget_surface(V4L2Context *ctx, V4L2Surface *surface)
+{
+    for (int i = 0; i < TS_MAP_SIZE; i++)
+        if (ctx->ts_map[i].surface == surface)
+            ctx->ts_map[i].surface = NULL;
+    for (int i = 0; i < ctx->num_capture_buffers; i++)
+        if (ctx->cap_slot[i] == surface)
+            ctx->cap_slot[i] = NULL;
+    if (ctx->render_target == surface)
+        ctx->render_target = NULL;
+}
