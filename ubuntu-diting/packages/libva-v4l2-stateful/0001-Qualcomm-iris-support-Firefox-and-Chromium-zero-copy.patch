+    uint32_t stride = ALIGN_UP(surface->width, 128);
+    uint32_t y_rows = ALIGN_UP(surface->height, 32);
+    uint32_t uv_rows = ALIGN_UP((surface->height + 1) / 2, 16);
+    size_t size = ALIGN_UP((size_t)stride * (y_rows + uv_rows), 4096);
+    uint32_t rows = (size + stride - 1) / stride;
+
+    surface->own_bo = gbm_bo_create(drv->gbm, stride, rows,
+                                    GBM_FORMAT_R8, GBM_BO_USE_LINEAR);
+    if (surface->own_bo == NULL) {
+        LOG("gbm_bo_create %ux%u failed", stride, rows);
+        return -1;
+    }
+
+    surface->own_stride = gbm_bo_get_stride(surface->own_bo);
+    surface->own_uv_offset = (size_t)surface->own_stride * y_rows;
+    surface->own_size = (size_t)surface->own_stride * rows;
+    surface->own_fd = gbm_bo_get_fd(surface->own_bo);
+    if (surface->own_fd >= 0) {
+        void *ptr = mmap(NULL, surface->own_size, PROT_READ | PROT_WRITE,
+                         MAP_SHARED, surface->own_fd, 0);
+        if (ptr != MAP_FAILED) {
+            surface->own_ptr = ptr;
+            LOG("Surface-owned buffer %ux%u, stride %u", surface->width,
+                surface->height, surface->own_stride);
+            return 0;
+        }
+        LOG("mmap of surface-owned buffer failed: %s", strerror(errno));
+        close(surface->own_fd);
+        surface->own_fd = -1;
+    }
+    gbm_bo_destroy(surface->own_bo);
+    surface->own_bo = NULL;
+    return -1;
