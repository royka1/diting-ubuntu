+    if (ctx->cap_dmabuf) {
+        V4L2Surface *owner = ctx->cap_slot[buf.index];
+        bool good = surface != NULL && planes[0].bytesused != 0 &&
+                    !(buf.flags & V4L2_BUF_FLAG_ERROR);
+
+        if (good && owner != surface) {
+            /* Filled out of order: move the picture to its surface */
+            LOG("CAPTURE buffer %u (ts %llu) landed in another surface, copying",
+                buf.index, (unsigned long long)ts);
+            if (owner != NULL) {
+                struct dma_buf_sync sync = { .flags = DMA_BUF_SYNC_START | DMA_BUF_SYNC_RW };
+                ioctl(owner->own_fd, DMA_BUF_IOCTL_SYNC, &sync);
+                ioctl(surface->own_fd, DMA_BUF_IOCTL_SYNC, &sync);
+                memcpy(surface->own_ptr, owner->own_ptr, ctx->cap_size);
+                sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_RW;
+                ioctl(surface->own_fd, DMA_BUF_IOCTL_SYNC, &sync);
+                ioctl(owner->own_fd, DMA_BUF_IOCTL_SYNC, &sync);
+            }
+        }
+        if (!good)
+            LOG("CAPTURE buffer %u (ts %llu, %u bytes, flags 0x%x) has no picture",
