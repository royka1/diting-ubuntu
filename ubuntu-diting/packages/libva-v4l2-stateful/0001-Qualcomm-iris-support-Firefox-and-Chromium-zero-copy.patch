-    surface->capture_idx = buf.index;
+    uint64_t ts = (uint64_t)buf.timestamp.tv_sec * 1000000 + buf.timestamp.tv_usec;
+    V4L2Surface *surface = NULL;
+    for (int i = 0; i < TS_MAP_SIZE; i++) {
+        if (ctx->ts_map[i].surface && ctx->ts_map[i].ts == ts) {
+            surface = ctx->ts_map[i].surface;
