From e381e89441fad961f842ab02fb4b69cea58b1326 Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Tue, 13 Oct 2026 14:46:15 +0200
Subject: [PATCH 3/8] hexagonrpcd: apps_std: Add fwrite, fremove,
 fopen_with_env_fd, fclose_fd

Port of the WIP methods from z3ntu/hexagonrpc branch apps_std_fwrite
(Luca Weiss) to the interp4 method definitions. Needed by the sensor
registry on the SDSP:

 - fwrite (5): fake the registry's "DIR" and "version=3" writes
 - fremove (24): fake success
 - fclose_fd (35), fopen_with_env_fd (36): stubs
 - fopen_with_env: allow write modes, files stay read-only

Upstream already supports interfaces with more than 31 methods.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hexagonrpcd/apps_std.c           | 136 +++++++++++++++++++++++++++++--
 hexagonrpcd/interface/apps_std.c |  58 +++++++++++++
 hexagonrpcd/interface/apps_std.h |   4 +
 3 files changed, 191 insertions(+), 7 deletions(-)

diff --git a/hexagonrpcd/apps_std.c b/hexagonrpcd/apps_std.c
index 7172bf0..fd2540c 100644
--- a/hexagonrpcd/apps_std.c
+++ b/hexagonrpcd/apps_std.c
@@ -120,6 +120,44 @@ static uint32_t apps_std_fread(void *data,
 	return 0;
 }
 
+/*
+ * Writing is not supported by hexagonfs. The sensor registry on the SDSP
+ * writes a "DIR" marker and "version=3" to its version file, report those
+ * writes as successful (from z3ntu/hexagonrpc apps_std_fwrite).
+ */
+static uint32_t apps_std_fwrite(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	const struct {
+		uint32_t fd;
+		uint32_t buf_size;
+	} *first_in = inbufs[0].p;
+	const char *buf = inbufs[1].p;
+	struct {
+		uint32_t written;
+		uint32_t is_eof;
+	} *first_out = outbufs[0].p;
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("write(%u, %u)\n", first_in->fd, first_in->buf_size);
+#endif
+
+	if ((first_in->buf_size == 3 && !memcmp(buf, "DIR", 3))
+	 || (first_in->buf_size == 9 && !memcmp(buf, "version=3", 9))) {
+		fprintf(stderr, "Faking successful write of \"%.*s\" to %u\n",
+				(int) first_in->buf_size, buf, first_in->fd);
+		first_out->written = first_in->buf_size;
+		first_out->is_eof = 0;
+		return 0;
+	}
+
+	fprintf(stderr, "Tried to write %u bytes to %u\n",
+			first_in->buf_size, first_in->fd);
+
+	return AEE_EFAILED;
+}
+
 static uint32_t apps_std_fseek(void *data,
 			       const struct fastrpc_io_buffer *inbufs,
 			       struct fastrpc_io_buffer *outbufs)
@@ -166,11 +204,13 @@ static uint32_t apps_std_fopen_with_env(void *data,
 		return AEE_EBADPARM;
 
 	rw_mode = ((const char *) inbufs[4].p)[0];
-	if (rw_mode == 'w' || rw_mode == 'a') {
-		fprintf(stderr, "Tried to open %s for writing\n",
+	/*
+	 * Files are opened read-only, writes are handled by apps_std_fwrite.
+	 * The sensor registry opens its version file for writing.
+	 */
+	if (rw_mode == 'w' || rw_mode == 'a')
+		fprintf(stderr, "Opening %s for writing (read-only)\n",
 				(const char *) inbufs[3].p);
-		return AEE_EUNSUPPORTED;
-	}
 
 	if (!strcmp(inbufs[1].p, "ADSP_LIBRARY_PATH")) {
 		dirfd = ctx->adsp_library_dirfd;
@@ -208,6 +248,24 @@ static uint32_t apps_std_fopen_with_env(void *data,
 	return 0;
 }
 
+/*
+ * Removing files is not supported, report success (from
+ * z3ntu/hexagonrpc apps_std_fremove).
+ */
+static uint32_t apps_std_fremove(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	// The name must be NULL-terminated
+	if (((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	fprintf(stderr, "Faking successful removal of %s\n",
+			(const char *) inbufs[1].p);
+
+	return 0;
+}
+
 static uint32_t apps_std_opendir(void *data,
 				 const struct fastrpc_io_buffer *inbufs,
 				 struct fastrpc_io_buffer *outbufs)
@@ -351,6 +409,53 @@ static uint32_t apps_std_stat(void *data,
 	return 0;
 }
 
+/*
+ * File descriptor sharing with the DSP is not implemented, these are the
+ * stubs from z3ntu/hexagonrpc.
+ */
+static uint32_t apps_std_fclose_fd(void *data,
+				   const struct fastrpc_io_buffer *inbufs,
+				   struct fastrpc_io_buffer *outbufs)
+{
+#ifdef HEXAGONRPC_VERBOSE
+	const struct {
+		uint32_t mid;
+		uint32_t fd;
+	} *first_in = inbufs[0].p;
+
+	printf("close_fd(%u)\n", first_in->fd);
+#endif
+
+	return 0;
+}
+
+static uint32_t apps_std_fopen_with_env_fd(void *data,
+					   const struct fastrpc_io_buffer *inbufs,
+					   struct fastrpc_io_buffer *outbufs)
+{
+	struct {
+		uint32_t fd;
+		uint32_t len;
+	} *first_out = outbufs[0].p;
+
+	// The name and environment variable must also be NULL-terminated
+	if (((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0
+	 || ((const char *) inbufs[2].p)[inbufs[2].s - 1] != 0
+	 || ((const char *) inbufs[3].p)[inbufs[3].s - 1] != 0
+	 || ((const char *) inbufs[4].p)[inbufs[4].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	fprintf(stderr, "fopen_with_env_fd($%s, %s, %s) stub\n",
+			(const char *) inbufs[1].p,
+			(const char *) inbufs[3].p,
+			(const char *) inbufs[4].p);
+
+	first_out->fd = 99;
+	first_out->len = 42;
+
+	return 0;
+}
+
 struct fastrpc_interface *fastrpc_apps_std_init(struct hexagonfs_dirent *root)
 {
 	struct fastrpc_interface *iface;
@@ -420,7 +525,10 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 		.def = &apps_std_fread_def,
 		.impl = apps_std_fread,
 	},
-	{ .def = NULL, .impl = NULL, },
+	{
+		.def = &apps_std_fwrite_def,
+		.impl = apps_std_fwrite,
+	},
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
@@ -445,7 +553,10 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
 	{ .def = NULL, .impl = NULL, },
-	{ .def = NULL, .impl = NULL, },
+	{
+		.def = &apps_std_fremove_def,
+		.impl = apps_std_fremove,
+	},
 	{ .def = NULL, .impl = NULL, },
 	{
 		.def = &apps_std_opendir_def,
@@ -465,10 +576,21 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 		.def = &apps_std_stat_def,
 		.impl = apps_std_stat,
 	},
+	{ .def = NULL, .impl = NULL, },
+	{ .def = NULL, .impl = NULL, },
+	{ .def = NULL, .impl = NULL, },
+	{
+		.def = &apps_std_fclose_fd_def,
+		.impl = apps_std_fclose_fd,
+	},
+	{
+		.def = &apps_std_fopen_with_env_fd_def,
+		.impl = apps_std_fopen_with_env_fd,
+	},
 };
 
 const struct fastrpc_interface apps_std_interface = {
 	.name = "apps_std",
-	.n_procs = 32,
+	.n_procs = 37,
 	.procs = apps_std_procs,
 };
