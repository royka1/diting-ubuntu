+++ b/hexagonrpcd/hexagonfs_mapped.c
@@ -22,6 +22,7 @@
 #include <dirent.h>
 #include <errno.h>
 #include <fcntl.h>
+#include <stdio.h>
 #include <unistd.h>
 #include <stdbool.h>
 #include <stdlib.h>
@@ -78,15 +79,15 @@ err:
 	return ret;
 }
 
-static int mapped_openat(struct hexagonfs_fd *dir,
-			 const char *segment,
-			 bool expect_dir,
-			 struct hexagonfs_fd **out)
+static int mapped_open_child(struct hexagonfs_fd *dir,
+			     const char *segment,
+			     int flags,
+			     struct hexagonfs_file_ops *ops,
+			     struct hexagonfs_fd **out)
 {
 	struct mapped_ctx *dir_ctx = dir->data;
 	struct hexagonfs_fd *fd;
 	struct mapped_ctx *ctx;
-	int flags = O_RDONLY;
 	int ret;
 
 	ctx = malloc(sizeof(struct mapped_ctx));
@@ -99,10 +100,7 @@ static int mapped_openat(struct hexagonfs_fd *dir,
 		goto err;
 	}
 
-	if (expect_dir)
-		flags |= O_DIRECTORY;
-
-	ctx->fd = openat(dir_ctx->fd, segment, flags);
+	ctx->fd = openat(dir_ctx->fd, segment, flags | O_CLOEXEC, 0644);
 	if (ctx->fd == -1) {
 		ret = -errno;
 		goto err_free_fd;
@@ -112,7 +110,7 @@ static int mapped_openat(struct hexagonfs_fd *dir,
 
 	fd->is_assigned = false;
 	fd->up = dir;
-	fd->ops = &hexagonfs_mapped_ops;
+	fd->ops = ops;
 	fd->data = ctx;
 
 	*out = fd;
@@ -126,6 +124,77 @@ err:
 	return ret;
 }
 
+static int mapped_openat(struct hexagonfs_fd *dir,
+			 const char *segment,
+			 bool expect_dir,
+			 struct hexagonfs_fd **out)
+{
+	return mapped_open_child(dir, segment,
+				 expect_dir ? O_RDONLY | O_DIRECTORY : O_RDONLY,
+				 &hexagonfs_mapped_ops, out);
+}
+
+/*
+ * Writable mapping: files below it can be created, written and removed.
+ * Used for state the remote processor updates, e.g. the sensor registry.
+ */
+static int mapped_rw_openat(struct hexagonfs_fd *dir,
+			    const char *segment,
+			    bool expect_dir,
+			    struct hexagonfs_fd **out)
+{
+	return mapped_open_child(dir, segment,
+				 expect_dir ? O_RDONLY | O_DIRECTORY : O_RDONLY,
+				 &hexagonfs_mapped_rw_ops, out);
+}
+
+static int mapped_rw_openat_flags(struct hexagonfs_fd *dir,
+				  const char *segment,
+				  int flags,
+				  struct hexagonfs_fd **out)
+{
+	if (strchr(segment, '/') != NULL)
+		return -EINVAL;
+
+	return mapped_open_child(dir, segment,
+				 flags & (O_ACCMODE | O_CREAT | O_TRUNC | O_APPEND),
+				 &hexagonfs_mapped_rw_ops, out);
+}
+
+static ssize_t mapped_rw_write(struct hexagonfs_fd *fd, size_t size, const void *ptr)
+{
+	struct mapped_ctx *ctx = fd->data;
+	ssize_t ret;
+
+	ret = write(ctx->fd, ptr, size);
+	if (ret < 0)
+		return -errno;
+
+	return ret;
+}
+
+static int mapped_rw_unlinkat(struct hexagonfs_fd *dir, const char *segment)
+{
+	struct mapped_ctx *ctx = dir->data;
+
+	if (unlinkat(ctx->fd, segment, 0))
+		return -errno;
+
+	return 0;
+}
+
+static int mapped_rw_renameat(struct hexagonfs_fd *olddir, const char *oldsegment,
+			      struct hexagonfs_fd *newdir, const char *newsegment)
+{
+	struct mapped_ctx *oldctx = olddir->data;
+	struct mapped_ctx *newctx = newdir->data;
+
+	if (renameat(oldctx->fd, oldsegment, newctx->fd, newsegment))
+		return -errno;
+
+	return 0;
+}
+
 static ssize_t mapped_read(struct hexagonfs_fd *fd, size_t size, void *out)
 {
 	struct mapped_ctx *ctx = fd->data;
@@ -351,3 +420,17 @@ struct hexagonfs_file_ops hexagonfs_mapped_sysfs_ops = {
 	.seek = mapped_seek,
 	.stat = mapped_sysfs_stat,
 };
+
+struct hexagonfs_file_ops hexagonfs_mapped_rw_ops = {
+	.close = mapped_close,
+	.from_dirent = mapped_from_dirent,
+	.openat = mapped_rw_openat,
+	.read = mapped_read,
+	.readdir = mapped_readdir,
+	.seek = mapped_seek,
+	.stat = mapped_stat,
+	.openat_flags = mapped_rw_openat_flags,
+	.write = mapped_rw_write,
+	.unlinkat = mapped_rw_unlinkat,
+	.renameat = mapped_rw_renameat,
+};
