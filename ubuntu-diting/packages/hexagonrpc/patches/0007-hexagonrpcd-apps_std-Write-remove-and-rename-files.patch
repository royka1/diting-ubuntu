From 33d3bd7b1adc1c7e22e5d9344f023256e364a33e Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Tue, 13 Oct 2026 15:10:23 +0200
Subject: [PATCH 7/8] hexagonrpcd: apps_std: Write, remove and rename files

Replace the faked fwrite and fremove with real ones on writable
mappings, open files with the flags of the fopen() mode, and add frename
(method 33). The sensor registry writes ../temp.json and renames it to
the registry group.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 hexagonrpcd/apps_std.c           | 127 +++++++++++++++++++++----------
 hexagonrpcd/interface/apps_std.c |  13 ++++
 hexagonrpcd/interface/apps_std.h |   1 +
 3 files changed, 101 insertions(+), 40 deletions(-)

diff --git a/hexagonrpcd/apps_std.c b/hexagonrpcd/apps_std.c
index fd2540c..1d06070 100644
--- a/hexagonrpcd/apps_std.c
+++ b/hexagonrpcd/apps_std.c
@@ -20,7 +20,9 @@
  */
 
 #include <errno.h>
+#include <fcntl.h>
 #include <libhexagonrpc/error.h>
+#include <stdbool.h>
 #include <stdio.h>
 #include <stdint.h>
 #include <string.h>
@@ -120,42 +122,56 @@ static uint32_t apps_std_fread(void *data,
 	return 0;
 }
 
-/*
- * Writing is not supported by hexagonfs. The sensor registry on the SDSP
- * writes a "DIR" marker and "version=3" to its version file, report those
- * writes as successful (from z3ntu/hexagonrpc apps_std_fwrite).
- */
 static uint32_t apps_std_fwrite(void *data,
 				const struct fastrpc_io_buffer *inbufs,
 				struct fastrpc_io_buffer *outbufs)
 {
+	struct apps_std_ctx *ctx = data;
 	const struct {
 		uint32_t fd;
 		uint32_t buf_size;
 	} *first_in = inbufs[0].p;
-	const char *buf = inbufs[1].p;
 	struct {
 		uint32_t written;
 		uint32_t is_eof;
 	} *first_out = outbufs[0].p;
+	ssize_t ret;
+
+	ret = hexagonfs_write(ctx->fds, first_in->fd,
+			      first_in->buf_size, inbufs[1].p);
+	if (ret < 0) {
+		fprintf(stderr, "Could not write file: %s\n", strerror(-ret));
+		return AEE_EFAILED;
+	}
 
 #ifdef HEXAGONRPC_VERBOSE
-	printf("write(%u, %u)\n", first_in->fd, first_in->buf_size);
+	printf("write(%u, %u) -> %ld\n", first_in->fd,
+					 first_in->buf_size,
+					 ret);
 #endif
 
-	if ((first_in->buf_size == 3 && !memcmp(buf, "DIR", 3))
-	 || (first_in->buf_size == 9 && !memcmp(buf, "version=3", 9))) {
-		fprintf(stderr, "Faking successful write of \"%.*s\" to %u\n",
-				(int) first_in->buf_size, buf, first_in->fd);
-		first_out->written = first_in->buf_size;
-		first_out->is_eof = 0;
-		return 0;
-	}
+	first_out->written = ret;
+	first_out->is_eof = 0;
 
-	fprintf(stderr, "Tried to write %u bytes to %u\n",
-			first_in->buf_size, first_in->fd);
+	return 0;
+}
 
-	return AEE_EFAILED;
+/*
+ * Translate an fopen() mode to open() flags. Only writable mappings accept
+ * the write modes.
+ */
+static int apps_std_mode_flags(const char *mode)
+{
+	bool plus = strchr(mode, '+') != NULL;
+
+	switch (mode[0]) {
+	case 'w':
+		return (plus ? O_RDWR : O_WRONLY) | O_CREAT | O_TRUNC;
+	case 'a':
+		return (plus ? O_RDWR : O_WRONLY) | O_CREAT | O_APPEND;
+	default:
+		return plus ? O_RDWR : O_RDONLY;
+	}
 }
 
 static uint32_t apps_std_fseek(void *data,
@@ -194,7 +210,6 @@ static uint32_t apps_std_fopen_with_env(void *data,
 {
 	struct apps_std_ctx *ctx = data;
 	uint32_t *out = outbufs[0].p;
-	char rw_mode;
 	int dirfd, fd;
 
 	// The name and environment variable must also be NULL-terminated
@@ -203,15 +218,6 @@ static uint32_t apps_std_fopen_with_env(void *data,
 	 || ((const char *) inbufs[4].p)[inbufs[4].s - 1] != 0)
 		return AEE_EBADPARM;
 
-	rw_mode = ((const char *) inbufs[4].p)[0];
-	/*
-	 * Files are opened read-only, writes are handled by apps_std_fwrite.
-	 * The sensor registry opens its version file for writing.
-	 */
-	if (rw_mode == 'w' || rw_mode == 'a')
-		fprintf(stderr, "Opening %s for writing (read-only)\n",
-				(const char *) inbufs[3].p);
-
 	if (!strcmp(inbufs[1].p, "ADSP_LIBRARY_PATH")) {
 		dirfd = ctx->adsp_library_dirfd;
 	} else if (!strcmp(inbufs[1].p, "ADSP_AVS_CFG_PATH")) {
@@ -228,18 +234,20 @@ static uint32_t apps_std_fopen_with_env(void *data,
 		return AEE_EFAILED;
 	}
 
-	fd = hexagonfs_openat(ctx->fds, ctx->rootfd, dirfd, inbufs[3].p);
+	fd = hexagonfs_openat_flags(ctx->fds, ctx->rootfd, dirfd, inbufs[3].p,
+				    apps_std_mode_flags(inbufs[4].p));
 	if (fd < 0) {
-		fprintf(stderr, "Could not open %s: %s\n",
+		fprintf(stderr, "Could not open %s (%s): %s\n",
 				(const char *) inbufs[3].p,
-				strerror(errno));
+				(const char *) inbufs[4].p,
+				strerror(-fd));
 		return AEE_EFAILED;
 	}
 
 #ifdef HEXAGONRPC_VERBOSE
-	printf("openat($%s, %s, %c) -> %d\n", (const char *) inbufs[1].p,
+	printf("openat($%s, %s, %s) -> %d\n", (const char *) inbufs[1].p,
 					      (const char *) inbufs[3].p,
-					      rw_mode,
+					      (const char *) inbufs[4].p,
 					      fd);
 #endif
 
@@ -248,20 +256,27 @@ static uint32_t apps_std_fopen_with_env(void *data,
 	return 0;
 }
 
-/*
- * Removing files is not supported, report success (from
- * z3ntu/hexagonrpc apps_std_fremove).
- */
 static uint32_t apps_std_fremove(void *data,
 				 const struct fastrpc_io_buffer *inbufs,
 				 struct fastrpc_io_buffer *outbufs)
 {
+	struct apps_std_ctx *ctx = data;
+	int ret;
+
 	// The name must be NULL-terminated
 	if (((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0)
 		return AEE_EBADPARM;
 
-	fprintf(stderr, "Faking successful removal of %s\n",
-			(const char *) inbufs[1].p);
+	ret = hexagonfs_unlinkat(ctx->fds, ctx->rootfd, ctx->rootfd, inbufs[1].p);
+	if (ret) {
+		fprintf(stderr, "Could not remove %s: %s\n",
+				(const char *) inbufs[1].p, strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("remove(%s)\n", (const char *) inbufs[1].p);
+#endif
 
 	return 0;
 }
@@ -409,6 +424,35 @@ static uint32_t apps_std_stat(void *data,
 	return 0;
 }
 
+static uint32_t apps_std_frename(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	int ret;
+
+	// The names must be NULL-terminated
+	if (((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0
+	 || ((const char *) inbufs[2].p)[inbufs[2].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	ret = hexagonfs_renameat(ctx->fds, ctx->rootfd, ctx->rootfd,
+				 inbufs[1].p, inbufs[2].p);
+	if (ret) {
+		fprintf(stderr, "Could not rename %s to %s: %s\n",
+				(const char *) inbufs[1].p,
+				(const char *) inbufs[2].p, strerror(-ret));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("rename(%s, %s)\n", (const char *) inbufs[1].p,
+				   (const char *) inbufs[2].p);
+#endif
+
+	return 0;
+}
+
 /*
  * File descriptor sharing with the DSP is not implemented, these are the
  * stubs from z3ntu/hexagonrpc.
@@ -577,7 +621,10 @@ static const struct fastrpc_function_impl apps_std_procs[] = {
 		.impl = apps_std_stat,
 	},
 	{ .def = NULL, .impl = NULL, },
-	{ .def = NULL, .impl = NULL, },
+	{
+		.def = &apps_std_frename_def,
+		.impl = apps_std_frename,
+	},
 	{ .def = NULL, .impl = NULL, },
 	{
 		.def = &apps_std_fclose_fd_def,
diff --git a/hexagonrpcd/interface/apps_std.c b/hexagonrpcd/interface/apps_std.c
index 4e18f73..5a4fcab 100644
--- a/hexagonrpcd/interface/apps_std.c
+++ b/hexagonrpcd/interface/apps_std.c
@@ -210,6 +210,19 @@ const struct hrpc_method_def_interp4 apps_std_stat_def = {
 	.inner_types = NULL,
 };
 
+static struct hrpc_arg_def_interp4 apps_std_frename_args[] = {
+	{ HRPC_ARG_BLOB_SEQ, sizeof(char) },
+	{ HRPC_ARG_BLOB_SEQ, sizeof(char) },
+};
+
+const struct hrpc_method_def_interp4 apps_std_frename_def = {
+	.msg_id = 33,
+	.n_args = HRPC_ARRAY_SIZE(apps_std_frename_args),
+	.args = apps_std_frename_args,
+	.n_inner_types = 0,
+	.inner_types = NULL,
+};
+
 static struct hrpc_arg_def_interp4 apps_std_fclose_fd_args[] = {
 	{ HRPC_ARG_WORD, sizeof(uint32_t) },
 	{ HRPC_ARG_WORD, sizeof(uint32_t) },
diff --git a/hexagonrpcd/interface/apps_std.h b/hexagonrpcd/interface/apps_std.h
index d885350..f6ee9a7 100644
--- a/hexagonrpcd/interface/apps_std.h
+++ b/hexagonrpcd/interface/apps_std.h
@@ -37,6 +37,7 @@ extern struct hrpc_method_def_interp4 apps_std_closedir_def;
 extern struct hrpc_method_def_interp4 apps_std_readdir_def;
 extern struct hrpc_method_def_interp4 apps_std_mkdir_def;
 extern struct hrpc_method_def_interp4 apps_std_stat_def;
+extern struct hrpc_method_def_interp4 apps_std_frename_def;
 extern struct hrpc_method_def_interp4 apps_std_fclose_fd_def;
 extern struct hrpc_method_def_interp4 apps_std_fopen_with_env_fd_def;
 
