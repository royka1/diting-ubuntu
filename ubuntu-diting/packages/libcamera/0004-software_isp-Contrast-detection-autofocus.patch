@@ -3,15 +3,28 @@
  * Copyright (C) 2025 Vasiliy Doylov <nekodevelopper@gmail.com>
  *
  * Auto focus
+ *
+ * Contrast detection autofocus on the software ISP's focus measure (the
+ * absolute second derivative of green in the centre of the image, divided
+ * by the green level so that exposure changes do not count as focus
+ * changes). A scan visits the lens range in coarse steps, then the
+ * neighbourhood of the best coarse position in fine steps, waiting a few
+ * statistics periods after every lens move (the statistics are gathered on
+ * every fourth frame, which is enough for a voice coil lens to settle). In continuous mode a scan is started at
+ * the beginning and again when the measure at the chosen position changes
+ * for several frames (scene change). Lens positions are on a 0..100 scale
+ * mapped linearly onto the lens driver's focus range.
  */
 
 #include "af.h"
 
+#include <algorithm>
+#include <cmath>
 #include <stdint.h>
 
 #include <libcamera/base/log.h>
 
-#include "control_ids.h"
+#include <libcamera/control_ids.h>
 
 namespace libcamera {
 
@@ -23,45 +36,199 @@ Af::Af()
 {
 }
 
-int Af::init(IPAContext &context,
-	     [[maybe_unused]] const YamlObject &tuningData)
+int Af::init(IPAContext &context, const YamlObject &tuningData)
 {
+	settleFrames_ = tuningData["settleFrames"].get<unsigned int>(0);
+	coarseStep_ = tuningData["coarseStep"].get<double>(10.0);
+	fineStep_ = tuningData["fineStep"].get<double>(2.0);
+	changeThreshold_ = tuningData["changeThreshold"].get<double>(0.35);
+	changeFrames_ = tuningData["changeFrames"].get<unsigned int>(6);
+
 	context.ctrlMap[&controls::LensPosition] = ControlInfo(0.0f, 100.0f, 50.0f);
+	context.ctrlMap[&controls::AfMode] =
+		ControlInfo(controls::AfModeValues, ControlValue(controls::AfModeContinuous));
+	context.ctrlMap[&controls::AfTrigger] = ControlInfo(controls::AfTriggerValues);
+
 	return 0;
 }
 
 int Af::configure(IPAContext &context,
 		  [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
-	context.activeState.knobs.focus_pos = std::optional<double>();
+	auto &af = context.activeState.af;
+
+	af = {};
+	af.mode = controls::AfModeContinuous;
+	af.state = controls::AfStateIdle;
+	af.position = 50.0;
+	context.activeState.knobs.focus_pos = af.position;
+
+	/* Without a lens there is nothing to do */
+	if (context.configuration.focus.focus_max <= context.configuration.focus.focus_min)
+		return 0;
+
+	startScan(context);
 
 	return 0;
 }
 
-void Af::queueRequest([[maybe_unused]] typename Module::Context &context,
+void Af::startScan(IPAContext &context)
+{
+	auto &af = context.activeState.af;
+
+	af.scanning = true;
+	af.fine = false;
+	af.start = 0.0;
+	af.stop = 100.0;
+	af.step = coarseStep_;
+	af.position = af.start;
+	af.bestPosition = af.start;
+	af.bestScore = 0.0;
+	af.minScore = INFINITY;
+	af.settle = settleFrames_ + 2;	/* the first move can be long */
+	af.changed = 0;
+	af.state = controls::AfStateScanning;
+
+	LOG(IPASoftAutoFocus, Debug) << "Starting scan";
+}
+
+void Af::stopScan(IPAContext &context, bool found)
+{
+	auto &af = context.activeState.af;
+
+	af.scanning = false;
+	af.position = af.bestPosition;
+	af.settle = settleFrames_ + 1;
+	af.refScore = 0.0;	/* measured once the lens is back */
+	af.changed = 0;
+	af.state = found ? controls::AfStateFocused : controls::AfStateFailed;
+
+	LOG(IPASoftAutoFocus, Debug)
+		<< "Scan done: position " << af.bestPosition
+		<< " score " << af.bestScore << " (min " << af.minScore << ")"
+		<< (found ? "" : ", no contrast peak");
+}
+
+void Af::scanStep(IPAContext &context, double score)
+{
+	auto &af = context.activeState.af;
+
+	if (score > af.bestScore) {
+		af.bestScore = score;
+		af.bestPosition = af.position;
+	}
+	af.minScore = std::min(af.minScore, score);
+
+	if (af.position + af.step <= af.stop + 1e-6) {
+		af.position += af.step;
+		af.settle = settleFrames_;
+		return;
+	}
+
+	if (!af.fine) {
+		/* Fine pass around the best coarse position */
+		af.fine = true;
+		af.start = std::clamp(af.bestPosition - coarseStep_, 0.0, 100.0);
+		af.stop = std::clamp(af.bestPosition + coarseStep_, 0.0, 100.0);
+		af.step = fineStep_;
+		af.position = af.start;
+		af.bestScore = 0.0;
+		af.settle = settleFrames_ + 1;
+		return;
+	}
+
+	/* A flat curve has no focus peak (no texture, too dark) */
+	stopScan(context, af.bestScore > af.minScore * 1.15);
+}
+
+void Af::monitor(IPAContext &context, double score)
+{
+	auto &af = context.activeState.af;
+
+	if (af.mode != controls::AfModeContinuous)
+		return;
+
+	if (af.refScore <= 0.0) {
+		af.refScore = score;
+		return;
+	}
+
+	if (std::abs(score - af.refScore) > af.refScore * changeThreshold_) {
+		if (++af.changed >= changeFrames_) {
+			LOG(IPASoftAutoFocus, Debug)
+				<< "Scene changed (" << score << " vs "
+				<< af.refScore << "), rescanning";
+			startScan(context);
+		}
+	} else {
+		af.changed = 0;
+	}
+}
+
+void Af::queueRequest(typename Module::Context &context,
 		      [[maybe_unused]] const uint32_t frame,
 		      [[maybe_unused]] typename Module::FrameContext &frameContext,
 		      const ControlList &controls)
 {
-	const auto &focus_pos = controls.get(controls::LensPosition);
-	if (focus_pos.has_value()) {
-		context.activeState.knobs.focus_pos = focus_pos;
-		LOG(IPASoftAutoFocus, Debug) << "Setting focus position to " << focus_pos.value();
+	auto &af = context.activeState.af;
+
+	const auto &mode = controls.get(controls::AfMode);
+	if (mode && *mode != af.mode) {
+		af.mode = *mode;
+		af.scanning = false;
+		af.state = controls::AfStateIdle;
+		if (af.mode == controls::AfModeContinuous)
+			startScan(context);
 	}
-}
 
-void Af::updateFocus([[maybe_unused]] IPAContext &context, [[maybe_unused]] IPAFrameContext &frameContext, [[maybe_unused]] double exposureMSV)
-{
-	frameContext.lens.focus_pos = context.activeState.knobs.focus_pos.value_or(50.0) / 100.0 * (context.configuration.focus.focus_max - context.configuration.focus.focus_min);
+	const auto &position = controls.get(controls::LensPosition);
+	if (position && af.mode == controls::AfModeManual) {
+		af.position = std::clamp<double>(*position, 0.0, 100.0);
+		LOG(IPASoftAutoFocus, Debug) << "Lens position " << af.position;
+	}
+
+	const auto &trigger = controls.get(controls::AfTrigger);
+	if (trigger && af.mode == controls::AfModeAuto) {
+		if (*trigger == controls::AfTriggerStart) {
+			startScan(context);
+		} else if (*trigger == controls::AfTriggerCancel) {
+			af.scanning = false;
+			af.state = controls::AfStateIdle;
+		}
+	}
+
+	context.activeState.knobs.focus_pos = af.position;
 }
 
-void Af::process([[maybe_unused]] IPAContext &context,
+void Af::process(IPAContext &context,
 		 [[maybe_unused]] const uint32_t frame,
-		 [[maybe_unused]] IPAFrameContext &frameContext,
-		 [[maybe_unused]] const SwIspStats *stats,
-		 [[maybe_unused]] ControlList &metadata)
+		 IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
 {
-	updateFocus(context, frameContext, 0);
+	auto &af = context.activeState.af;
+	const auto &focus = context.configuration.focus;
+
+	if (focus.focus_max > focus.focus_min && stats && stats->valid) {
+		/* Focus measure independent of the exposure */
+		double green = std::max<double>(stats->sum_.g(), 1.0);
+		double score = static_cast<double>(stats->sharpness) * 1e6 / green;
+
+		if (af.settle) {
+			af.settle--;
+		} else if (af.scanning) {
+			scanStep(context, score);
+		} else {
+			monitor(context, score);
+		}
+	}
+
+	context.activeState.knobs.focus_pos = af.position;
+	frameContext.lens.focus_pos = focus.focus_min +
+		std::lround(af.position / 100.0 * (focus.focus_max - focus.focus_min));
+
+	metadata.set(controls::AfState, af.state);
+	metadata.set(controls::LensPosition, static_cast<float>(af.position));
 }
 
 REGISTER_IPA_ALGORITHM(Af, "Af")
