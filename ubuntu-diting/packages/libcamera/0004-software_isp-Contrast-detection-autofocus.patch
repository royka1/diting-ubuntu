+/*
+ * Focus measure: absolute second derivative of green along the line, in the
+ * centre half of the window (xpix is the pixel position of the sample).
+ */
+#define SWSTATS_ACCUMULATE_SHARPNESS(xpix)                                  \
+	if (sharpLine_ && (xpix) >= window_.width / 4 &&                    \
+	    (xpix) < window_.width * 3 / 4) {                               \
+		if (sharpN >= 2)                                            \
+			sharp += std::abs(static_cast<int>(g) - 2 * sharpG1 + sharpG0); \
+		sharpN++;                                                   \
+		sharpG0 = sharpG1;                                          \
+		sharpG1 = g;                                                \
+	}
+
