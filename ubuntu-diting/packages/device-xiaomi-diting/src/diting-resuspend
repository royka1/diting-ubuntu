#!/bin/bash
# Put the phone back to sleep after a wake-up that nobody asked for.
#
# The ADSP charger firmware sends a Xiaomi status message every 480 s, and
# that message ends deep sleep. After every resume GNOME turns the screen on
# for a minute and its idle timer does not suspend again, so without this
# the phone stays awake with the screen off until it is next used.
#
# The system-sleep hook runs "diting-resuspend --pre" before suspend (records
# the power and volume key interrupt counts) and "--post" right after resume:
# when no key was pressed it creates /run/diting-resuspend.dark, which tells
# phosh (patched, see packages/phosh) to keep the screen off. The hook then
# starts this service, which suspends again unless, within RESUSPEND_DELAY
# seconds of the resume, a key was pressed, an input device reported an event
# while the screen was on (touch, keys, headset), something inhibits sleep or
# a call is active. Input while the screen stays off (a touch in a pocket)
# does not keep the phone awake.

set -u

DELAY="${RESUSPEND_DELAY:-20}"
KEYS=/run/diting-resuspend.keys
DARK=/run/diting-resuspend.dark

key_irqs() {
	awk '/pmic_pwrkey|pmic_resin/ {
		for (i = 2; i <= NF && $i ~ /^[0-9]+$/; i++) s += $i
	} END { print s + 0 }' /proc/interrupts
}

key_pressed() {
	[ -r "$KEYS" ] && [ "$(key_irqs)" != "$(cat "$KEYS")" ]
}

case "${1:-}" in
--pre)
	rm -f "$DARK"
	key_irqs > "$KEYS"
	exit 0 ;;
--post)
	if key_pressed; then rm -f "$DARK"; else : > "$DARK"; fi
	exit 0 ;;
esac

# Wait up to DELAY seconds for an event on any input device while a display
# is on; 0 = event seen
input_seen() {
	python3 -I -c '
import glob, os, select, sys, time

def display_on():
    for p in glob.glob("/sys/class/drm/card*-DSI-*/dpms"):
        try:
            if open(p).read().strip() == "On":
                return True
        except OSError:
            pass
    return False

fds = []
for p in sys.argv[2:]:
    try:
        fds.append(os.open(p, os.O_RDONLY | os.O_NONBLOCK))
    except OSError:
        pass
end = time.monotonic() + float(sys.argv[1])
while (left := end - time.monotonic()) > 0:
    r, _, _ = select.select(fds, [], [], left)
    for fd in r:
        try:
            while os.read(fd, 4096):
                pass
        except OSError:
            pass
    if r and display_on():
        sys.exit(0)
sys.exit(1)
' "$1" /dev/input/event*
}

# logind block inhibitors (systemd-inhibit --what=sleep --mode=block)
logind_inhibited() {
	busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
		org.freedesktop.login1.Manager BlockInhibited 2>/dev/null |
		grep -qE '[":]sleep[":]'
}

# Apps asking the desktop session not to suspend (GTK inhibit, flag 4)
session_inhibited() {
	local bus uid user
	for bus in /run/user/*/bus; do
		[ -S "$bus" ] || continue
		uid="${bus#/run/user/}"; uid="${uid%/bus}"
		user="$(id -nu "$uid" 2>/dev/null)" || continue
		busctl --user -M "$user@" call org.gnome.SessionManager \
			/org/gnome/SessionManager org.gnome.SessionManager \
			IsInhibited u 4 2>/dev/null | grep -qx 'b true' && return 0
	done
	return 1
}

call_active() {
	command -v mmcli >/dev/null || return 1
	mmcli -m any --voice-list-calls 2>/dev/null | grep -q '/Call/'
}

if input_seen "$DELAY"; then
	echo "input after resume: staying awake"
	exit 0
fi
if key_pressed; then
	echo "key pressed since suspend: staying awake"
	exit 0
fi
for check in logind_inhibited session_inhibited call_active; do
	if "$check"; then
		echo "$check: staying awake"
		exit 0
	fi
done

echo "no input ${DELAY} s after resume and nothing inhibits sleep: suspending again"
exec systemctl suspend
