#!/bin/sh
# Record the key interrupt counts before suspend; after resume, mark a wake-up
# without a key press for phosh and check whether the phone should go back to
# sleep (diting-resuspend.service). Runs inside
# systemd-sleep, so do not block.
[ "$2" = suspend ] || exit 0
case "$1" in
pre) /usr/libexec/diting/diting-resuspend --pre ;;
post)
	/usr/libexec/diting/diting-resuspend --post
	systemctl --no-block restart diting-resuspend.service ;;
esac
exit 0
