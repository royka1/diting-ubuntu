#!/usr/bin/make -f
%:
	dh $@

override_dh_installsystemd:
	# Never stop/restart the USB gadget on upgrade: it is often the link the
	# upgrade runs over (SSH via NCM).
	dh_installsystemd --no-start --no-stop-on-upgrade

override_dh_fixperms:
	dh_fixperms
	# NetworkManager ignores keyfiles that are readable by others
	chmod 600 debian/device-xiaomi-diting/usr/lib/NetworkManager/system-connections/*.nmconnection
