From 0f80da4bef96ab7f7a4cc1e834f5c7eb9f33c8f9 Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Wed, 21 Oct 2026 11:28:26 +0200
Subject: [PATCH 96/96] arm64: dts: qcom: sm8475-xiaomi-diting: Add the SLPI
 sleep state entry

Export the "sleepstate" smp2p entry to the SLPI and drive it from the
smp2p sleep state driver, like the vendor device tree does
(qcom,smp2p-dsps sleepstate-out and qcom,smp2p_sleepstate).

Signed-off-by: royka1 <397414+royka1@users.noreply.github.com>
---
 .../boot/dts/qcom/sm8475-xiaomi-diting.dts    | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
index 3cf300cf2..fe61b4b17 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
@@ -817,6 +817,25 @@ &remoteproc_slpi {
 	status = "okay";
 };
 
+/*
+ * The SLPI firmware reads the "sleepstate" smp2p entry to know whether
+ * the application processor is suspended (vendor DT: qcom,smp2p-dsps
+ * sleepstate-out and qcom,smp2p_sleepstate).
+ */
+&{/smp2p-slpi} {
+	smp2p_slpi_sleepstate_out: sleepstate {
+		qcom,entry-name = "sleepstate";
+		#qcom,smem-state-cells = <1>;
+	};
+};
+
+/ {
+	smp2p-sleepstate {
+		compatible = "qcom,smp2p-sleepstate";
+		qcom,smem-states = <&smp2p_slpi_sleepstate_out 0>;
+	};
+};
+
 &remoteproc_mpss {
 	/* squashed from the vendor firmware_mnt modem.mdt + modem.bNN */
 	firmware-name = "qcom/sm8475/xiaomi/diting/modem.mbn";
-- 
