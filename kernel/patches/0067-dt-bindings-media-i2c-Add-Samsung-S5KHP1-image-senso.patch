From 4603cdf504a4d52e175dfb788055f6bfd70d788f Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Tue, 13 Oct 2026 18:13:35 +0200
Subject: [PATCH 67/69] dt-bindings: media: i2c: Add Samsung S5KHP1 image
 sensor

200MP Samsung ISOCELL HP1 with a 3-trio MIPI C-PHY output, as used for
the rear main camera of the Xiaomi 12T Pro.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/media/i2c/samsung,s5khp1.yaml    | 114 ++++++++++++++++++
 1 file changed, 114 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/samsung,s5khp1.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/samsung,s5khp1.yaml b/Documentation/devicetree/bindings/media/i2c/samsung,s5khp1.yaml
new file mode 100644
index 000000000..6eaf27a51
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/samsung,s5khp1.yaml
@@ -0,0 +1,114 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/samsung,s5khp1.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S5KHP1 Image Sensor
+
+description:
+  Samsung S5KHP1 (ISOCELL HP1) image sensor is a 200MP image sensor. The
+  sensor is controlled over a serial camera control bus protocol, the
+  widest supported output image frame size is 16384x12288, data output
+  format is RAW10 transferred over a 3-trio MIPI C-PHY interface. The module
+  specific register settings are loaded as firmware.
+
+maintainers:
+  - Roy Kaandorp <397414+royka1@users.noreply.github.com>
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: samsung,s5khp1
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: MCLK supply clock.
+    maxItems: 1
+
+  reset-gpios:
+    description: Active low GPIO connected to RESET pad of the sensor.
+    maxItems: 1
+
+  vdda-supply:
+    description: Analogue voltage supply, 2.9 volts.
+
+  vdda2-supply:
+    description: Second analogue voltage supply of the module.
+
+  vddd-supply:
+    description: Digital core voltage supply, 1.1 volts.
+
+  vddio-supply:
+    description: Digital I/O voltage supply, 1.8 volts.
+
+  firmware-name:
+    maxItems: 1
+    description: Register table firmware of the camera module.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          bus-type:
+            const: 1
+
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+
+        required:
+          - bus-type
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+      #include <dt-bindings/gpio/gpio.h>
+
+      i2c {
+          #address-cells = <1>;
+          #size-cells = <0>;
+
+          camera@10 {
+              compatible = "samsung,s5khp1";
+              reg = <0x10>;
+              clocks = <&camera_mclk 0>;
+              assigned-clocks = <&camera_mclk 0>;
+              assigned-clock-rates = <19200000>;
+              reset-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
+              vdda-supply = <&vreg_2p9>;
+              vdda2-supply = <&vreg_3p1>;
+              vddd-supply = <&vreg_1p1>;
+              vddio-supply = <&vreg_1p8>;
+              firmware-name = "s5khp1.camregs";
+
+              port {
+                  endpoint {
+                      bus-type = <1>;
+                      data-lanes = <1 2 3>;
+                      link-frequencies = /bits/ 64 <848526000>;
+                      remote-endpoint = <&mipi_csi2_ep>;
+                  };
+              };
+          };
+      };
+...
-- 
