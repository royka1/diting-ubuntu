From: royka1 <397414+royka1@users.noreply.github.com>
Date: Sun, 11 Oct 2026 19:49:53 +0200
Subject: [PATCH 03/46] arm64: dts: qcom: Add SM8475 SoC dtsi

Describe SM8475 as a delta on top of sm8450.dtsi:
- sm8475 compatibles for GCC, DISPCC, GPUCC, CAMCC and VIDEOCC (drivers
  and bindings already upstream)
- Synopsys eUSB2 PHY at 0x88e3000 replacing the SM8450 femto PHY
- v6-layout QMP UFS PHY at 0x1d80000 (qcom,sm8475-qmp-ufs-phy)

PCIe, GPU OPPs and other SM8475 differences are not described yet; the
inherited SM8450 nodes stay disabled.

Based on the sm8450-mainline community sm8475.dtsi by Danila Tikhonov.
Local Diting bring-up patch, not submitted upstream.
---
 arch/arm64/boot/dts/qcom/sm8475.dtsi | 74 ++++++++++++++++++++++++++++
 1 file changed, 74 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/sm8475.dtsi

diff --git a/arch/arm64/boot/dts/qcom/sm8475.dtsi b/arch/arm64/boot/dts/qcom/sm8475.dtsi
new file mode 100644
index 000000000..abda88d88
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/sm8475.dtsi
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * SM8475 (Snapdragon 8+ Gen 1) is derived from SM8450. Only the blocks that
+ * are known to differ and are supported by upstream drivers are described
+ * here; everything else is inherited from sm8450.dtsi.
+ *
+ * Based on the sm8450-mainline community sm8475.dtsi by Danila Tikhonov,
+ * reduced to the parts that match upstream bindings.
+ */
+
+#include "sm8450.dtsi"
+
+/delete-node/ &usb_1_hsphy;
+/delete-node/ &ufs_mem_phy;
+
+&soc {
+	/* SM8475 uses an eUSB2 PHY instead of the SM8450 femto PHY */
+	usb_1_hsphy: phy@88e3000 {
+		compatible = "qcom,sm8475-snps-eusb2-phy",
+			     "qcom,sm8550-snps-eusb2-phy";
+		reg = <0 0x088e3000 0 0x154>;
+		#phy-cells = <0>;
+
+		clocks = <&rpmhcc RPMH_CXO_CLK>;
+		clock-names = "ref";
+
+		resets = <&gcc GCC_QUSB2PHY_PRIM_BCR>;
+
+		status = "disabled";
+	};
+
+	/* v6 register layout, 0x2000 bytes at 0x1d80000 */
+	ufs_mem_phy: phy@1d80000 {
+		compatible = "qcom,sm8475-qmp-ufs-phy";
+		reg = <0 0x01d80000 0 0x2000>;
+
+		clocks = <&rpmhcc RPMH_CXO_CLK>,
+			 <&gcc GCC_UFS_PHY_PHY_AUX_CLK>,
+			 <&gcc GCC_UFS_0_CLKREF_EN>;
+		clock-names = "ref",
+			      "ref_aux",
+			      "qref";
+
+		power-domains = <&gcc UFS_PHY_GDSC>;
+
+		resets = <&ufs_mem_hc 0>;
+		reset-names = "ufsphy";
+
+		#clock-cells = <1>;
+		#phy-cells = <0>;
+
+		status = "disabled";
+	};
+};
+
+&camcc {
+	compatible = "qcom,sm8475-camcc";
+};
+
+&dispcc {
+	compatible = "qcom,sm8475-dispcc";
+};
+
+&gcc {
+	compatible = "qcom,sm8475-gcc";
+};
+
+&gpucc {
+	compatible = "qcom,sm8475-gpucc";
+};
+
+&videocc {
+	compatible = "qcom,sm8475-videocc";
+};
