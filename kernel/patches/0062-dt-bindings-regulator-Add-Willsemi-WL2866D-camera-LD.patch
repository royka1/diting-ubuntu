From: royka1 <397414+royka1@users.noreply.github.com>
Date: Tue, 13 Oct 2026 16:32:09 +0200
Subject: [PATCH 62/64] dt-bindings: regulator: Add Willsemi WL2866D camera LDO

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/regulator/willsemi,wl2866d.yaml  | 81 +++++++++++++++++++
 1 file changed, 81 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/regulator/willsemi,wl2866d.yaml

diff --git a/Documentation/devicetree/bindings/regulator/willsemi,wl2866d.yaml b/Documentation/devicetree/bindings/regulator/willsemi,wl2866d.yaml
new file mode 100644
index 000000000..bfd33a98f
--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/willsemi,wl2866d.yaml
@@ -0,0 +1,81 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/willsemi,wl2866d.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Willsemi WL2866D camera LDO
+
+maintainers:
+  - Roy Kaandorp <397414+royka1@users.noreply.github.com>
+
+description:
+  The WL2866D is an I2C controlled power management IC for camera modules
+  with two DVDD LDOs (0.6 V to 1.8 V, supplied from VIN1) and two AVDD LDOs
+  (1.2 V to 4.3 V, supplied from VIN2).
+
+properties:
+  compatible:
+    const: willsemi,wl2866d
+
+  reg:
+    maxItems: 1
+
+  enable-gpios:
+    maxItems: 1
+    description: GPIO connected to the EN pin of the chip.
+
+  vin1-supply:
+    description: Input supply of the DVDD LDOs.
+
+  vin2-supply:
+    description: Input supply of the AVDD LDOs and bias supply.
+
+  regulators:
+    type: object
+    additionalProperties: false
+
+    patternProperties:
+      "^(dvdd|avdd)[12]$":
+        type: object
+        $ref: regulator.yaml#
+        unevaluatedProperties: false
+
+required:
+  - compatible
+  - reg
+  - regulators
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        pmic@28 {
+            compatible = "willsemi,wl2866d";
+            reg = <0x28>;
+            enable-gpios = <&tlmm 44 GPIO_ACTIVE_HIGH>;
+            vin1-supply = <&vreg_1p25>;
+            vin2-supply = <&vreg_bob>;
+
+            regulators {
+                dvdd2 {
+                    regulator-name = "cam_dvdd2";
+                    regulator-min-microvolt = <1200000>;
+                    regulator-max-microvolt = <1200000>;
+                };
+
+                avdd1 {
+                    regulator-name = "cam_avdd1";
+                    regulator-min-microvolt = <1800000>;
+                    regulator-max-microvolt = <1800000>;
+                };
+            };
+        };
+    };
+...
