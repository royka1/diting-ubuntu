From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Mon, 12 Oct 2026 15:15:54 +0200
Subject: [PATCH 26/46] arm64: dts: qcom: sm8475-xiaomi-diting: Add pmic-glink

Battery, charger and USB-C status from the ADSP firmware. No connector
node yet; the USB port stays a fixed peripheral.
---
 arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
index af69f7806..5fee1ea04 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
@@ -952,6 +952,17 @@ &usb_1_hsphy {
 };
 
 / {
+	/*
+	 * Battery, charger and USB-C state come from the ADSP firmware
+	 * (vendor pmic_glink: battery_charger, ucsi). No connector yet: the
+	 * USB port stays a fixed peripheral for the debug link.
+	 */
+	pmic-glink {
+		compatible = "qcom,sm8450-pmic-glink", "qcom,pmic-glink";
+		#address-cells = <1>;
+		#size-cells = <0>;
+	};
+
 	aliases {
 		serial1 = &uart20;	/* qcom_geni_serial needs a line number */
 	};
