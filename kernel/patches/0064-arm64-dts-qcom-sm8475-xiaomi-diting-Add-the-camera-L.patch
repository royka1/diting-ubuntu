From deab88e31a4536b375a6826df5a56c909a07f913 Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Tue, 13 Oct 2026 16:32:09 +0200
Subject: [PATCH 64/64] arm64: dts: qcom: sm8475-xiaomi-diting: Add the camera
 LDOs, ultrawide I/O and core

The WL2866D on i2c5 (vendor xiaomi,wl2866d at 0x28, EN on TLMM 44)
supplies the ultrawide sensor's 1.8 V I/O (AVDD1) and 1.2 V core
(DVDD2): the vendor power-up log enables exactly these two outputs for
the S5K4H7 probe (its module data power types 0xf and 0xe). Without
them the sensor does not answer on CCI. Voltages are the vendor register
codes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/sm8475-xiaomi-diting.dts    | 58 ++++++++++++++++++-
 1 file changed, 56 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
index 0592974d3..3ca17e5e2 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
@@ -555,7 +555,51 @@ &i2c5 {
 	clock-frequency = <100000>;
 	status = "okay";
 
-	/* fsa4480 typec mux @ 0x42 and wl2866d camera PMIC @ 0x28: TODO */
+	/* fsa4480 typec mux @ 0x42: TODO */
+
+	/*
+	 * Camera LDOs (vendor xiaomi,wl2866d, EN on TLMM 44). Voltages are the
+	 * vendor register codes: DVDD1 0x54, DVDD2 0x64, AVDD1 0x30, AVDD2 0x98
+	 * (vendor "avdd2"). Per the vendor power-up log, AVDD1 is the 1.8 V I/O
+	 * supply of the ultrawide and front sensors, DVDD2 the ultrawide core,
+	 * DVDD1 the front core, AVDD2 the main camera.
+	 */
+	cam_ldo: pmic@28 {
+		compatible = "willsemi,wl2866d";
+		reg = <0x28>;
+		enable-gpios = <&tlmm 44 GPIO_ACTIVE_HIGH>;
+		vin1-supply = <&vreg_s12b_1p25>;
+		vin2-supply = <&vreg_bob>;
+
+		pinctrl-0 = <&cam_ldo_en>;
+		pinctrl-names = "default";
+
+		regulators {
+			cam_ldo_dvdd1: dvdd1 {
+				regulator-name = "cam_ldo_dvdd1";
+				regulator-min-microvolt = <1104000>;
+				regulator-max-microvolt = <1104000>;
+			};
+
+			cam_ldo_dvdd2: dvdd2 {
+				regulator-name = "cam_ldo_dvdd2";
+				regulator-min-microvolt = <1200000>;
+				regulator-max-microvolt = <1200000>;
+			};
+
+			cam_ldo_avdd1: avdd1 {
+				regulator-name = "cam_ldo_avdd1";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
+			cam_ldo_avdd2: avdd2 {
+				regulator-name = "cam_ldo_avdd2";
+				regulator-min-microvolt = <3100000>;
+				regulator-max-microvolt = <3100000>;
+			};
+		};
+	};
 
 	/*
 	 * The vendor DT uses a generic "nxp,eusb2-repeater" compatible at
@@ -617,7 +661,8 @@ &cci0_i2c0 {
 	/*
 	 * Rear ultrawide: Sunny module with a Samsung S5K4H7 (vendor
 	 * qcom,cam-sensor2: CCI0 master 0, slave 0x5a, MCLK1, reset TLMM 24,
-	 * AVDD only; the module data asks for a 24 MHz MCLK). Register tables
+	 * AVDD; I/O and core from the WL2866D, power types 0xf/0xe in the
+	 * module data; the module data asks for a 24 MHz MCLK). Register tables
 	 * from the module data, see firmware-xiaomi-diting.
 	 */
 	camera@2d {
@@ -633,6 +678,8 @@ camera@2d {
 		pinctrl-names = "default";
 
 		vdda-supply = <&cam_ultra_avdd>;
+		vddd-supply = <&cam_ldo_dvdd2>;
+		vddio-supply = <&cam_ldo_avdd1>;
 
 		firmware-name = "qcom/sm8475/xiaomi/diting/s5k4h7-ultra.camregs";
 
@@ -995,6 +1042,13 @@ &tlmm {
 	/* Secure-world owned, per qcom,gpios-reserved in the vendor DT */
 	gpio-reserved-ranges = <28 4>, <36 4>;
 
+	cam_ldo_en: cam-ldo-en-state {
+		pins = "gpio44";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	cam_mclk1_default: cam-mclk1-default-state {
 		pins = "gpio101";
 		function = "cam_mclk";
-- 
2.47.3

