From 6e52c8edb37a000f9f9c4b1fd23d071a7ce7dbd1 Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Wed, 14 Oct 2026 22:58:08 +0200
Subject: [PATCH 88/88] arm64: dts: qcom: sm8475-xiaomi-diting: Add the Wi-Fi
 calibration variant

The QCA6490 has no board id programmed (board id 255), the same as the
generic entries in linux-firmware's WCN6855 board-2.bin. Name the
phone's own board data with a calibration variant so that it can be
looked up separately.

Signed-off-by: royka1 <397414+royka1@users.noreply.github.com>
---
 arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
index d62756a6e..d577528c9 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
@@ -1115,6 +1115,8 @@ wifi@0 {
 		compatible = "pci17cb,1103";
 		reg = <0x10000 0x0 0x0 0x0 0x0>;
 
+		qcom,calibration-variant = "Xiaomi_diting";
+
 		vddrfacmn-supply = <&vreg_pmu_rfa_cmn_0p8>;
 		vddaon-supply = <&vreg_pmu_aon_0p8>;
 		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
-- 
2.55.0

