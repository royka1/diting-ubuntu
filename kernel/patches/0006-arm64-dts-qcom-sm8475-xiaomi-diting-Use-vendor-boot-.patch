From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Sun, 11 Oct 2026 23:24:58 +0200
Subject: [PATCH 06/46] arm64: dts: qcom: sm8475-xiaomi-diting: Use vendor boot
 voltages as minimum

For RPMh regulators the initial voltage is unknown, so the regulator
core applies the constraint minimum. With the vendor min/max ranges
this lowered consumer rails far below what the vendor kernel uses, e.g.
the UFS/eUSB2 PHY supply L5B ran at 0.72 V instead of 0.88 V and the
repeater supply L2B at 2.704 V instead of 3.072 V (measured on device,
2026-10-11). Raise every minimum to the vendor qcom,init-voltage.

Local Diting bring-up patch, not submitted upstream.
---
 .../boot/dts/qcom/sm8475-xiaomi-diting.dts    | 30 ++++++++++---------
 1 file changed, 16 insertions(+), 14 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
index e77871ab1..352e95b0a 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
@@ -128,8 +128,10 @@ vph_pwr: regulator-vph-pwr {
 
 &apps_rsc {
 	/*
-	 * Voltage ranges are the vendor DT constraints. Supply parents are
-	 * not described yet because the board power tree is unverified.
+	 * Minimum voltages are the vendor boot-time (qcom,init-voltage) values,
+	 * maxima the vendor DT constraints, so consumers that do not set a
+	 * voltage run at the vendor voltage instead of the range minimum.
+	 * Supply parents are not described yet (board power tree unverified).
 	 */
 	regulators-0 {
 		compatible = "qcom,pm8350-rpmh-regulators";
@@ -143,40 +145,40 @@ vreg_s10b_1p8: smps10 {
 
 		vreg_s11b_0p95: smps11 {
 			regulator-name = "vreg_s11b_0p95";
-			regulator-min-microvolt = <382000>;
+			regulator-min-microvolt = <952000>;
 			regulator-max-microvolt = <1170000>;
 		};
 
 		vreg_s12b_1p25: smps12 {
 			regulator-name = "vreg_s12b_1p25";
-			regulator-min-microvolt = <1224000>;
+			regulator-min-microvolt = <1256000>;
 			regulator-max-microvolt = <2040000>;
 		};
 
 		vreg_l1b_0p91: ldo1 {
 			regulator-name = "vreg_l1b_0p91";
-			regulator-min-microvolt = <830000>;
+			regulator-min-microvolt = <912000>;
 			regulator-max-microvolt = <920000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
 
 		vreg_l2b_3p07: ldo2 {
 			regulator-name = "vreg_l2b_3p07";
-			regulator-min-microvolt = <2700000>;
+			regulator-min-microvolt = <3072000>;
 			regulator-max-microvolt = <3300000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
 
 		vreg_l3b_0p9: ldo3 {
 			regulator-name = "vreg_l3b_0p9";
-			regulator-min-microvolt = <870000>;
+			regulator-min-microvolt = <904000>;
 			regulator-max-microvolt = <970000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
 
 		vreg_l5b_0p88: ldo5 {
 			regulator-name = "vreg_l5b_0p88";
-			regulator-min-microvolt = <720000>;
+			regulator-min-microvolt = <880000>;
 			regulator-max-microvolt = <958000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
@@ -190,7 +192,7 @@ vreg_l6b_1p2: ldo6 {
 
 		vreg_l7b_2p5: ldo7 {
 			regulator-name = "vreg_l7b_2p5";
-			regulator-min-microvolt = <2400000>;
+			regulator-min-microvolt = <2504000>;
 			regulator-max-microvolt = <3544000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
@@ -209,7 +211,7 @@ regulators-1 {
 
 		vreg_s1c_1p86: smps1 {
 			regulator-name = "vreg_s1c_1p86";
-			regulator-min-microvolt = <1800000>;
+			regulator-min-microvolt = <1880000>;
 			regulator-max-microvolt = <2024000>;
