From 3803f8e052e5a0a2c36784a20446dc5b922c8bc4 Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Thu, 15 Oct 2026 20:58:42 +0200
Subject: [PATCH] power: supply: qcom_battmgr: Ignore the Xiaomi status
 messages

The charger firmware on Xiaomi SM8475 phones (diting) sends an
unsolicited message with opcode 0x50 every 480 seconds. Xiaomi's
downstream driver calls it BC_XM_STATUS_GET. The driver logged it as
"unknown message 0x50" and then completed the ack. If a property
request was in flight at that moment, the request returned before its
reply arrived. Drop the message before dispatch.

The same code also arrives as a notification after boot, when Xiaomi's
vendor properties change. None of them are exported, so ignore that
notification too instead of logging an error.

Signed-off-by: royka1 <397414+royka1@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01TusYKnwv3Mdszu23WUyV1b
---
 drivers/power/supply/qcom_battmgr.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index b7e6570ae..6d65eccb3 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -100,6 +100,9 @@ enum qcom_battmgr_variant {
 #define WLS_BOOST_EN			6
 
 #define BATTMGR_CHG_CTRL_LIMIT_EN	0x48
+
+/* Unsolicited vendor status broadcast of the Xiaomi charger firmware */
+#define BATTMGR_XIAOMI_STATUS		0x50
 #define CHARGE_CTRL_START_THR_MIN	50
 #define CHARGE_CTRL_START_THR_MAX	95
 #define CHARGE_CTRL_END_THR_MIN		55
@@ -1244,6 +1247,9 @@ static void qcom_battmgr_notification(struct qcom_battmgr *battmgr,
 	case NOTIF_WLS_PROPERTY:
 		power_supply_changed(battmgr->wls_psy);
 		break;
+	case BATTMGR_XIAOMI_STATUS:
+		/* Xiaomi vendor properties changed; none of them are exported */
+		break;
 	default:
 		dev_err(battmgr->dev, "unknown notification: %#x\n", notification);
 		break;
@@ -1608,6 +1614,14 @@ static void qcom_battmgr_callback(const void *data, size_t len, void *priv)
 	struct qcom_battmgr *battmgr = priv;
 	unsigned int opcode = le32_to_cpu(hdr->opcode);
 
+	/*
+	 * Xiaomi firmware broadcasts its own status block every few minutes.
+	 * It is not a reply to a request, so it must not complete the ack of
+	 * a request that is in flight.
+	 */
+	if (opcode == BATTMGR_XIAOMI_STATUS)
+		return;
+
 	if (opcode == BATTMGR_NOTIFICATION)
 		qcom_battmgr_notification(battmgr, data, len);
 	else if (battmgr->variant == QCOM_BATTMGR_SC8280XP ||
-- 
