From 82b627a96d214c8b215d6f560b9efe76199e1c3a Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Tue, 13 Oct 2026 18:30:43 +0200
Subject: [PATCH 74/74] arm64: dts: qcom: sm8475-xiaomi-diting: Link the main
 camera to CAMSS

The S5KHP1 is wired to CSIPHY 2 over three C-PHY trios.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
index 2c828a521..980d19d9b 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
@@ -678,6 +678,15 @@ csiphy1_ep: endpoint {
 				remote-endpoint = <&cam_ultra_ep>;
 			};
 		};
+
+		/* Rear main S5KHP1, vendor csiphy-sd-index 2: three C-PHY trios */
+		port@2 {
+			csiphy2_ep: endpoint {
+				data-lanes = <0 1 2>;
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+				remote-endpoint = <&cam_wide_ep>;
+			};
+		};
 	};
 };
 
@@ -735,8 +744,6 @@ &cci0_i2c1 {
 	 * reset TLMM 126, CSIPHY 2). Power-up order of the module data:
 	 * WL2866D AVDD2 (type 0x10), AVDD1 (0xf, 1.8 V I/O), AVDD 2.9 V,
 	 * DVDD 1.1 V, reset release, MCLK. C-PHY, three trios.
-	 *
-	 * Not linked to CAMSS yet: mainline CAMSS has no C-PHY support.
 	 */
 	camera@10 {
 		compatible = "samsung,s5khp1";
@@ -765,6 +772,7 @@ cam_wide_ep: endpoint {
 				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
 				data-lanes = <1 2 3>;
 				link-frequencies = /bits/ 64 <848526000 1042384000 1194928000>;
+				remote-endpoint = <&csiphy2_ep>;
 			};
 		};
 	};
-- 
