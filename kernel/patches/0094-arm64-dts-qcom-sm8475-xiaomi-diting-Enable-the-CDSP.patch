From 8eda4b3da0e212e0e40773b270549ec603f03eac Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Wed, 21 Oct 2026 11:27:37 +0200
Subject: [PATCH 94/96] arm64: dts: qcom: sm8475-xiaomi-diting: Enable the CDSP

Enable the compute DSP with the device-signed firmware from the vendor
firmware_mnt partition, squashed into a single image like the other
remote processors. The carveout and the FastRPC context bank stream IDs
of sm8450.dtsi match the vendor device tree.

Signed-off-by: royka1 <397414+royka1@users.noreply.github.com>
---
 arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
index d577528c9..3cf300cf2 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
@@ -823,6 +823,17 @@ &remoteproc_mpss {
 	status = "okay";
 };
 
+&remoteproc_cdsp {
+	/*
+	 * Compute DSP (Hexagon with HVX/HTP); squashed from the vendor
+	 * firmware_mnt cdsp.mdt + cdsp.bNN. Carveout as the vendor DT
+	 * (cdsp_region@89900000, 0x2000000), compute context banks with
+	 * the same SIDs as the vendor DT (0x2161..0x2168).
+	 */
+	firmware-name = "qcom/sm8475/xiaomi/diting/cdsp.mbn";
+	status = "okay";
+};
+
 &remoteproc_adsp {
 	/* squashed from the vendor firmware_mnt adsp.mdt + adsp.bNN */
 	firmware-name = "qcom/sm8475/xiaomi/diting/adsp.mbn";
-- 
2.55.0

