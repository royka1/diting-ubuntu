+	{0x015C, 0x66, 0x00, CSIPHY_DEFAULT_PARAMS},
+	{0x035C, 0x66, 0x00, CSIPHY_DEFAULT_PARAMS},
+	{0x055C, 0x66, 0x00, CSIPHY_DEFAULT_PARAMS},
+	{0x09B4, 0x03, 0x00, CSIPHY_DEFAULT_PARAMS},
