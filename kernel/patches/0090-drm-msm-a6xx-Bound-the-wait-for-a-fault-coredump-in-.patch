From adab3e954d387f65ebec1bba62d0c7df9909f14d Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Thu, 15 Oct 2026 12:06:03 +0200
Subject: [PATCH] drm/msm/a6xx: Bound the wait for a fault coredump in GMU
 transactions

GPU recovery can deadlock with the SMMU fault handler:

  recover_worker (holds gpu->lock)
    a6xx_recover -> runtime suspend -> a6xx_gmu_stop
      a6xx_gmu_set_oob: OOB times out, fault_coredump_done not done
        wait_for_completion(fault_coredump_done)

  arm-smmu context fault thread
    adreno_fault_handler: reinit_completion(fault_coredump_done)
      msm_gpu_fault_crashstate_capture: mutex_lock(gpu->lock)

The completion is only signalled after the fault handler gets gpu->lock,
which recovery never releases. On the Xiaomi 12T Pro a GPU fault during
a phone call left phoc in D state waiting on a fence that never signals,
and the screen stayed dark until a reboot.

Wait at most one second for the coredump, then give up the GMU
transaction as timed out, as before the coredump wait existed.

Signed-off-by: royka1 <397414+royka1@users.noreply.github.com>
---
 drivers/gpu/drm/msm/adreno/a6xx_gmu.c | 8 +++++++-
 drivers/gpu/drm/msm/adreno/a6xx_hfi.c | 8 +++++++-
 2 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
index 0a65a6169..48cb0bbdd 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
@@ -443,8 +443,14 @@ int a6xx_gmu_set_oob(struct a6xx_gmu *gmu, enum a6xx_gmu_oob_state state)
 		/* We may timeout because the GMU is temporarily wedged from
 		 * pending faults from the GPU and we are taking a devcoredump.
 		 * Wait until the MMU is resumed and try again.
+		 *
+		 * Bound the wait: the fault handler takes gpu->lock to capture
+		 * the devcoredump, and GPU recovery calls in here while holding
+		 * that lock. An unbounded wait then deadlocks both.
 		 */
-		wait_for_completion(&a6xx_gpu->base.fault_coredump_done);
+		if (!wait_for_completion_timeout(&a6xx_gpu->base.fault_coredump_done,
+						 msecs_to_jiffies(1000)))
+			break;
 	} while (true);
 
 	if (ret)
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_hfi.c b/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
index 186a73c0b..16e085889 100644
--- a/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_hfi.c
@@ -128,8 +128,14 @@ static int a6xx_hfi_wait_for_msg_interrupt(struct a6xx_gmu *gmu, u32 id, u32 seq
 		/* We may timeout because the GMU is temporarily wedged from
 		 * pending faults from the GPU and we are taking a devcoredump.
 		 * Wait until the MMU is resumed and try again.
+		 *
+		 * Bound the wait: the fault handler takes gpu->lock to capture
+		 * the devcoredump, and GPU recovery calls in here while holding
+		 * that lock. An unbounded wait then deadlocks both.
 		 */
-		wait_for_completion(&a6xx_gpu->base.fault_coredump_done);
+		if (!wait_for_completion_timeout(&a6xx_gpu->base.fault_coredump_done,
+						 msecs_to_jiffies(1000)))
+			break;
 	} while (true);
 
 	if (ret) {
-- 
