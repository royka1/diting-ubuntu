From 2e988fbe95f39182bd9766f5a14a4ca06b2123d7 Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Tue, 13 Oct 2026 18:13:36 +0200
Subject: [PATCH 69/69] arm64: dts: qcom: sm8475-xiaomi-diting: Add the rear
 main camera sensor

Samsung S5KHP1 on CCI0 master 1 at 0x10 (vendor qcom,cam-sensor0: slave
0x20, MCLK2 19.2 MHz on TLMM 102, reset TLMM 126), with its 2.9 V AVDD
(TLMM 70) and 1.1 V DVDD (TLMM 2) LDOs and the WL2866D AVDD1/AVDD2. Not
linked to CAMSS yet, which has no C-PHY support.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/qcom/sm8475-xiaomi-diting.dts    | 98 +++++++++++++++++++
 1 file changed, 98 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
index 8ac9e4d3a..2c828a521 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
@@ -189,6 +189,34 @@ top_out_mux: audio-mux-top {
 		pinctrl-names = "default";
 	};
 
+	/* Main camera 2.9 V AVDD, switched by TLMM 70 (vendor camera_wide_avdd_ldo) */
+	cam_wide_avdd: regulator-cam-wide-avdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_wide_avdd";
+		regulator-min-microvolt = <2900000>;
+		regulator-max-microvolt = <2900000>;
+		gpio = <&tlmm 70 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_bob>;
+
+		pinctrl-0 = <&cam_wide_avdd_en>;
+		pinctrl-names = "default";
+	};
+
+	/* Main camera 1.1 V DVDD, switched by TLMM 2 (vendor camera_wide_dvdd_ldo) */
+	cam_wide_dvdd: regulator-cam-wide-dvdd {
+		compatible = "regulator-fixed";
+		regulator-name = "cam_wide_dvdd";
+		regulator-min-microvolt = <1100000>;
+		regulator-max-microvolt = <1100000>;
+		gpio = <&tlmm 2 GPIO_ACTIVE_HIGH>;
+		enable-active-high;
+		vin-supply = <&vreg_s12b_1p25>;
+
+		pinctrl-0 = <&cam_wide_dvdd_en>;
+		pinctrl-names = "default";
+	};
+
 	/* Ultrawide camera 2.8 V AVDD, switched by TLMM 6 (vendor CAMERA_ULTRA_AVDD) */
 	cam_ultra_avdd: regulator-cam-ultra-avdd {
 		compatible = "regulator-fixed";
@@ -700,6 +728,48 @@ cam_ultra_ep: endpoint {
 		};
 	};
 };
+&cci0_i2c1 {
+	/*
+	 * Rear main: Semco module with a Samsung S5KHP1 (vendor
+	 * qcom,cam-sensor0: CCI0 master 1, slave 0x20, MCLK2 19.2 MHz,
+	 * reset TLMM 126, CSIPHY 2). Power-up order of the module data:
+	 * WL2866D AVDD2 (type 0x10), AVDD1 (0xf, 1.8 V I/O), AVDD 2.9 V,
+	 * DVDD 1.1 V, reset release, MCLK. C-PHY, three trios.
+	 *
+	 * Not linked to CAMSS yet: mainline CAMSS has no C-PHY support.
+	 */
+	camera@10 {
+		compatible = "samsung,s5khp1";
+		reg = <0x10>;
+
+		clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK2_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		reset-gpios = <&tlmm 126 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&cam_mclk2_default>, <&cam_wide_reset>;
+		pinctrl-names = "default";
+
+		vdda2-supply = <&cam_ldo_avdd2>;
+		vddio-supply = <&cam_ldo_avdd1>;
+		vdda-supply = <&cam_wide_avdd>;
+		vddd-supply = <&cam_wide_dvdd>;
+
+		firmware-name = "qcom/sm8475/xiaomi/diting/s5khp1-wide.camregs";
+
+		orientation = <1>;
+		rotation = <270>;
+
+		port {
+			cam_wide_ep: endpoint {
+				bus-type = <MEDIA_BUS_TYPE_CSI2_CPHY>;
+				data-lanes = <1 2 3>;
+				link-frequencies = /bits/ 64 <848526000 1042384000 1194928000>;
+			};
+		};
+	};
+};
+
 
 &remoteproc_slpi {
 	/*
@@ -1061,6 +1131,34 @@ cam_mclk1_default: cam-mclk1-default-state {
 		bias-disable;
 	};
 
+	cam_mclk2_default: cam-mclk2-default-state {
+		pins = "gpio102";
+		function = "cam_mclk";
+		drive-strength = <6>;
+		bias-disable;
+	};
+
+	cam_wide_avdd_en: cam-wide-avdd-en-state {
+		pins = "gpio70";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_wide_dvdd_en: cam-wide-dvdd-en-state {
+		pins = "gpio2";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	cam_wide_reset: cam-wide-reset-state {
+		pins = "gpio126";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	cam_ultra_avdd_en: cam-ultra-avdd-en-state {
 		pins = "gpio6";
 		function = "gpio";
-- 
2.47.3

