# Xiaomi Diting (SM8475) fragment applied on top of arm64 defconfig.
# Each option is justified; see docs/KERNEL_PORTING.md.

CONFIG_LOCALVERSION="-diting"
# CONFIG_LOCALVERSION_AUTO is not set

# Root storage path built in, so the first boot does not depend on
# initramfs module loading: UFS host + QMP UFS PHY + inline crypto engine.
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_QCOM_INLINE_CRYPTO_ENGINE=y

# USB peripheral debug path: eUSB2 PHY, PTN3222 repeater on QUP I2C, gadget.
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_NXP_PTN3222=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y

# PMIC power-on block: power/volume-down keys in the initramfs and
# reboot-mode ("reboot bootloader" -> fastboot) via the PMK8350 SDAM cell.
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_NVMEM_REBOOT_MODE=y

# Debug: console log in ramoops at the vendor location, readable from Android.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Debug: /sys/power/pm_wakeup_irq and pm_debug_messages, to find what wakes
# the phone from suspend.
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y

# Early display on the ABL splash buffer.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ABL appends "bootconfig" to the command line and a bootconfig block to the
# ramdisk (vendor boot v4); parse it instead of leaving it as an unknown arg.
CONFIG_BOOT_CONFIG=y

# Ubuntu userspace expectations.
CONFIG_AUTOFS_FS=y
CONFIG_FANOTIFY=y
CONFIG_SECCOMP=y
CONFIG_CGROUP_BPF=y

# Touchscreen: ST FTM5 on SPI (local driver, patch 0007).
CONFIG_TOUCHSCREEN_ST_FTM5_SPI=m

# Display panel (local driver, patch 0009).
CONFIG_DRM_PANEL_XIAOMI_L12_36_02_0B=m

# GPU: Ubuntu's linux-firmware-qualcomm-graphics ships zstd-compressed
# firmware (a730_sqe.fw.zst, gmu_gen70000.bin.zst).
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Loudspeaker amplifiers (2x Cirrus CS35L41 on I2C).
CONFIG_SND_SOC_CS35L41_I2C=m

# Camera clock controller: without a driver the RPMh power domains never
# reach sync_state and stay at their maximum votes, which blocks the
# SoC-wide (CX) power collapse in suspend.
CONFIG_SM_CAMCC_8450=m

# Cameras: CAMSS raw capture over the CCI-controlled sensors; the rear
# ultrawide is a Samsung S5K4H7 (register tables loaded as firmware).
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_I2C_QCOM_CCI=m
CONFIG_VIDEO_S5K4H7=m
CONFIG_VIDEO_S5KHP1=m
# Main camera lens actuator (AK7314, ak7375 driver)
CONFIG_VIDEO_AK7375=m
# Camera LDOs (Willsemi WL2866D on i2c5)
CONFIG_REGULATOR_WL2866D=m
# Buffers for the libcamera software ISP: udmabuf (session user access via
# systemd's uaccess rule) and the system dma-buf heap
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# Bring-up tracing: dynamic debug prints and ftrace/kprobe events, to follow
# the AudioReach/SoundWire paths on the phone (no runtime cost when unused).
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y

# Snaps (owner request): squashfs with the compressors snaps use (xz mostly,
# also zstd/lzo/lz4) and xattrs; snapd's strict confinement needs AppArmor
# as an active LSM (order as Ubuntu's kernels).
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,ipe,apparmor,bpf"

# Waydroid (owner request): binder through binderfs, PSI for Android's
# low-memory killer, uhid for input, and the container network (bridge,
# veth, NAT/masquerade through nftables as Ubuntu's iptables uses it, and
# the legacy iptables NAT table; CHECKSUM fills in the DHCP reply checksums
# of waydroid-net.sh, IPv6 masquerade serves its optional IPv6 NAT).
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
CONFIG_PSI=y
CONFIG_UHID=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_COMPAT=m
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m
# Android's netd (inside Waydroid) puts each network's routes in its own
# table selected by ip rules; without policy routing the container has no
# default route ("Network is unreachable"). The matches and targets below are
# the ones Android's base kernel config lists for netd's iptables chains,
# bandwidth accounting, firewall and socket handling.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_INET_UDP_DIAG=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_NETLINK_LOG=m
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=m
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=m
CONFIG_NETFILTER_XT_TARGET_MARK=m
CONFIG_NETFILTER_XT_TARGET_NFLOG=m
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=m
CONFIG_NETFILTER_XT_MATCH_HELPER=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
CONFIG_NETFILTER_XT_MATCH_LENGTH=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_MAC=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_QUOTA=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
CONFIG_NETFILTER_XT_MATCH_STRING=m
CONFIG_NETFILTER_XT_MATCH_TIME=m
CONFIG_NETFILTER_XT_MATCH_U32=m
CONFIG_IP_NF_RAW=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP6_NF_MATCH_RPFILTER=m
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m
